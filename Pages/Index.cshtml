@page
@model Ascendia.Pages.IndexModel
@{
    ViewData["Title"] = "Enrollment & School Bulletins";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold text-primary">Ascendia Enrollment Management System</h2>
        <h4 class="text-secondary">Enrollment &amp; School Bulletins</h4>
    </div>

    <div class="row g-4">
        <section class="col-lg-8">
            <h3 class="h4 mb-3">Available Courses</h3>
            @if (Model.Courses.Count == 0)
            {
                <div class="alert alert-info">Wala pang kursong nailalagay. Makipag-ugnayan sa Registrar.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var course in Model.Courses)
                    {
                        <div class="col-md-6">
                            <div class="card course-card shadow-sm border-success h-100">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title fw-bold text-success">@course.CourseCode</h5>
                                    <h6>@course.CourseName</h6>
                                    <p class="text-muted flex-grow-1">@course.Description</p>
                                    <a asp-page="/EnrollForm" asp-route-course="@course.CourseCode" class="btn btn-success mt-auto">Apply to this course</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <aside class="col-lg-4" aria-labelledby="bulletins-heading">
            <h3 id="bulletins-heading" class="h4 mb-3">School Notices &amp; Bulletins</h3>
            @if (Model.Notices.Count == 0)
            {
                <div class="alert alert-light border">Walang kasalukuyang bulletin.</div>
            }
            @foreach (var notice in Model.Notices)
            {
                var isAlert = notice.Category == "Alert";
                <article class="card mb-3 shadow-sm @(isAlert ? "border-danger" : "border-light")">
                    @if (notice.ImagePath is not null)
                    {
                        <img src="@notice.ImagePath" alt="@notice.Title" class="card-img-top bulletin-image" style="max-height: 260px; object-fit: contain; cursor: zoom-in;" data-full-image="@notice.ImagePath" />
                    }
                    <div class="card-body">
                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <span class="badge @(isAlert ? "bg-danger" : notice.Category == "Enrollment Schedule" ? "bg-primary" : "bg-secondary")">@notice.Category</span>
                            @if (notice.IsPinned) { <span class="badge bg-warning text-dark">Pinned</span> }
                        </div>
                        <h4 class="h5 card-title">@notice.Title</h4>
                        @if (!string.IsNullOrWhiteSpace(notice.Message))
                        {
                            <p class="card-text mb-2">@notice.Message</p>
                        }
                        <small class="text-muted">Posted @notice.DatePostedUtc.ToLocalTime().ToString("d")</small>
                    </div>
                </article>
            }
        </aside>
    </div>
</div>

<div class="modal fade" id="bulletinImageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark">
            <button type="button" class="btn-close btn-close-white ms-auto m-2" data-bs-dismiss="modal" aria-label="Close"></button>
            <img id="bulletin-modal-image" alt="Announcement image" class="img-fluid mx-auto" style="max-width: 100%; max-height: 85vh; object-fit: contain;" />
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.querySelectorAll(".bulletin-image").forEach(image => image.addEventListener("click", () => {
        document.getElementById("bulletin-modal-image").src = image.dataset.fullImage;
        bootstrap.Modal.getOrCreateInstance(document.getElementById("bulletinImageModal")).show();
    }));
</script>
}