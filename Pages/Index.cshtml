@page
@model Ascendia.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="container my-5">
    <section class="home-hero text-center mb-5">
        <h1 class="fw-bold">Ascendia</h1>
        <p class="lead mb-4">School announcements, enrollment schedules, and important updates.</p>
        <a asp-page="/Enrollment" class="btn btn-primary btn-lg">Enroll Now</a>
    </section>

    <section aria-labelledby="bulletins-heading">
        <h2 id="bulletins-heading" class="h3 mb-4">School Notices &amp; Bulletins</h2>
        @await Html.PartialAsync("_Bulletins", Model.Notices)
    </section>
</div>
