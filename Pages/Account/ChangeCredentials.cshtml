@page
@model Ascendia.Pages.Account.ChangeCredentialsModel
@{
    ViewData["Title"] = "Account Settings";
}

<div class="container mt-4" style="max-width: 640px;">
    <h1 class="h3 text-primary fw-bold">Account Settings</h1>
    <p class="text-muted">Current username: <strong>@Model.CurrentUsername</strong></p>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success" role="status">@statusMessage</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.CurrentPassword" class="form-label">Current password</label>
                    <input asp-for="Input.CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.NewUsername" class="form-label">New username <span class="text-muted">(optional)</span></label>
                    <input asp-for="Input.NewUsername" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Input.NewUsername" class="text-danger"></span>
                </div>
                <hr />
                <div class="mb-3">
                    <label asp-for="Input.NewPassword" class="form-label">New password <span class="text-muted">(optional)</span></label>
                    <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
                    <div class="form-text">At least 12 characters with uppercase and lowercase letters, a number, and a symbol.</div>
                    <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.ConfirmPassword" class="form-label">Confirm new password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a asp-page="/AdminDashboard" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
