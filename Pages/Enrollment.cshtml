@page "/Enrollment"
@model Ascendia.Pages.EnrollmentModel
@{
    ViewData["Title"] = "Enrollment";
}

<div class="container my-5">
    <header class="text-center mb-5">
        <h1 class="fw-bold">Enrollment</h1>
        <p class="lead">Choose an available course to begin your application.</p>
    </header>

    <h2 class="h3 mb-4">Available Courses</h2>
    @if (Model.Courses.Count == 0)
    {
        <div class="alert alert-info" role="status">Wala pang kursong nailalagay. Makipag-ugnayan sa Registrar.</div>
    }
    else
    {
        <div class="row g-4 align-items-stretch">
            @foreach (var course in Model.Courses)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <article class="card course-card shadow-sm h-100 border-success">
                        <div class="card-body d-flex flex-column">
                            <h2 class="h5 card-title fw-bold text-success">@course.CourseCode</h2>
                            <h3 class="h6">@course.CourseName</h3>
                            @if (!string.IsNullOrWhiteSpace(course.Description))
                            {
                                <p class="text-muted flex-grow-1">@course.Description</p>
                            }
                            else
                            {
                                <div class="flex-grow-1"></div>
                            }
                            <a asp-page="/EnrollForm" asp-route-course="@course.CourseCode" class="btn btn-success mt-auto">Apply to this course</a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
