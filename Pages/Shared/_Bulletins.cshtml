@model IReadOnlyList<Ascendia.Models.SchoolNotice>

@if (Model.Count == 0)
{
    <div class="alert alert-light border" role="status">No announcements yet.</div>
}
else
{
    <div class="row g-4">
        @foreach (var notice in Model)
        {
            var isAlert = notice.Category == "Alert";
            <div class="col-12 col-md-6 col-xl-4">
                <article class="card bulletin-card h-100 shadow-sm @(isAlert ? "bulletin-card-alert" : string.Empty)">
                    @if (!string.IsNullOrWhiteSpace(notice.ImagePath))
                    {
                        <button type="button"
                                class="bulletin-image-button"
                                data-bulletin-image="@notice.ImagePath"
                                data-bulletin-title="@notice.Title"
                                aria-label="Enlarge announcement image: @notice.Title">
                            <img src="@notice.ImagePath" alt="@notice.Title" class="bulletin-image" loading="lazy" />
                        </button>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex gap-2 flex-wrap mb-2">
                            <span class="badge @(isAlert ? "bg-danger" : notice.Category == "Enrollment Schedule" ? "bg-primary" : "bg-secondary")">@notice.Category</span>
                            @if (notice.IsPinned)
                            {
                                <span class="badge bg-warning text-dark">Pinned</span>
                            }
                        </div>
                        <h3 class="h5 card-title">@notice.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(notice.Message))
                        {
                            <p class="card-text flex-grow-1">@notice.Message</p>
                        }
                        <small class="text-muted mt-auto">Posted @notice.DatePostedUtc.ToLocalTime().ToString("d")</small>
                    </div>
                </article>
            </div>
        }
    </div>
}

<div class="modal fade" id="bulletinImageModal" tabindex="-1" aria-labelledby="bulletinImageModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <h2 class="modal-title visually-hidden" id="bulletinImageModalTitle">Announcement image</h2>
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-0">
                <img id="bulletin-modal-image" alt="Announcement image" class="bulletin-modal-image" />
            </div>
        </div>
    </div>
</div>

<script>
    (() => {
        const modalElement = document.getElementById("bulletinImageModal");
        const modalImage = document.getElementById("bulletin-modal-image");
        const modalTitle = document.getElementById("bulletinImageModalTitle");

        document.addEventListener("click", event => {
            const button = event.target.closest("[data-bulletin-image]");
            if (!button || !modalElement || !modalImage || !modalTitle) {
                return;
            }

            modalImage.src = button.dataset.bulletinImage;
            modalImage.alt = button.dataset.bulletinTitle || "Announcement image";
            modalTitle.textContent = modalImage.alt;
            bootstrap.Modal.getOrCreateInstance(modalElement).show();
        });
    })();
</script>
