@page
@model Ascendia.Pages.AdminDashboardModel
@{
    ViewData["Title"] = "Admin Management Portal";
}

<div class="container mt-4 mb-5">
    <div class="text-center mb-5">
        <h2 class="text-primary fw-bold">Ascendia</h2>
        <h4 class="text-secondary">Admin &amp; Registrar Management Portal</h4>
    </div>

    <div class="row admin-dashboard-grid g-4 align-items-stretch">
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-success fw-bold">1. Student Applications</h5>
                    <p class="card-text text-muted small flex-grow-1">Review pending enrollment submissions, view uploaded files (PSA, Form 138), approve or reject with remarks.</p>
                    <a asp-page="/Admin/StudentApplications" class="btn btn-primary mt-auto">Manage Applications</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-primary fw-bold">2. Academic Status &amp; Logs</h5>
                    <p class="card-text text-muted small flex-grow-1">Process Drop Subject, LOA/Stop, and Transfer requests with automatic timestamps and roster updates.</p>
                    <a asp-page="/Admin/AcademicRequests" class="btn btn-primary mt-auto">View Requests</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-info fw-bold">3. Departments &amp; Courses</h5>
                    <p class="card-text text-muted small flex-grow-1">CRUD management for institutional departments and programs (e.g., BSCPE) with dynamic descriptions.</p>
                    <a asp-page="/Admin/CoursesManagement" class="btn btn-primary mt-auto">Manage Courses</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-warning">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-warning fw-bold">4. Subjects &amp; Sections</h5>
                    <p class="card-text text-muted small flex-grow-1">Masterlist editor for subjects, credit units, class sections, schedules, room assignments, and capacity limits.</p>
                    <a asp-page="/Admin/SubjectsSections" class="btn btn-primary mt-auto">Manage Sections</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-danger">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-danger fw-bold">5. Payments &amp; Assessment</h5>
                    <p class="card-text text-muted small flex-grow-1">Cashiering dashboard, tuition rates per unit, misc/lab fees, and GCash/receipt verification.</p>
                    <a asp-page="/Admin/PaymentsAssessment" class="btn btn-primary mt-auto">Verify Payments</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-dark">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-dark fw-bold">6. Reports &amp; Masterlist</h5>
                    <p class="card-text text-muted small flex-grow-1">Filter students by status, generate printable class lists, and export masterlists to PDF or Excel.</p>
                    <a asp-page="/Admin/ReportsMasterlist" class="btn btn-primary mt-auto">Generate Reports</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-secondary">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-secondary fw-bold">7. Shifting &amp; Crediting Evaluation</h5>
                    <p class="card-text text-muted small flex-grow-1">Process course shifting applications, credit transfers from other colleges, and subject evaluations.</p>
                    <a asp-page="/Admin/ShiftingCrediting" class="btn btn-primary mt-auto">Evaluate Applications</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-warning">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-warning fw-bold">8. School Notices &amp; Portal Bulletins</h5>
                    <p class="card-text text-muted small flex-grow-1">Publish school notices, enrollment schedules, and important alerts directly to student portals.</p>
                    <a asp-page="/Admin/Notices" class="btn btn-primary mt-auto">Manage Notices</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-info fw-bold">9. Student Records Directory</h5>
                    <p class="card-text text-muted small flex-grow-1">Search and filter all enrolled students by name, student number, course, and status.</p>
                    <a asp-page="/Admin/StudentRecords" class="btn btn-primary mt-auto">View Records</a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-xl-4">
            <div class="card shadow-sm h-100 border-primary">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-primary fw-bold">10. Faculty &amp; Instructor Management</h5>
                    <p class="card-text text-muted small flex-grow-1">Manage instructors, assign them to subjects and sections, and monitor teaching loads.</p>
                    <a asp-page="/Admin/FacultyManagement" class="btn btn-primary mt-auto">Manage Faculty</a>
                </div>
            </div>
        </div>
    </div>
</div>
