@page
@model Ascendia.Pages.Admin.PaymentsAssessmentModel
@{
    ViewData["Title"] = "Payments & Assessment Module";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Payments & Assessment Management</h2>
    <p class="text-muted">Review approved students and record their remaining balances and payment statuses.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white fw-bold">Student Payment & Assessment List</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student ID</th>
                            <th>Full Name</th>
                            <th>Course</th>
                            <th>Receipt / Proof</th>
                            <th>Balance (₱)</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PaymentsList != null && Model.PaymentsList.Any())
                        {
                            @foreach (var item in Model.PaymentsList)
                            {
                                <tr>
                                    <td>@item.StudentNumber</td>
                                    <td>@item.StudentName</td>
                                    <td><span class="badge bg-secondary">@item.CourseCode</span></td>
                                    <td>
                                        @if (item.HasPaymentReceipt)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(item.StudentNumber))
                                            {
                                                <a asp-page="/Admin/StudentApplications"
                                                   asp-page-handler="Document"
                                                   asp-route-studentNumber="@item.StudentNumber"
                                                   asp-route-documentType="paymentreceipt"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="btn btn-sm btn-outline-primary">
                                                    View Receipt
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small">Student number unavailable.</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Walang payment receipt na isinumite.</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.RemainingBalance.HasValue)
                                        {
                                            <span class="fw-bold text-danger">₱@item.RemainingBalance.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not assessed</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Status == "Fully Paid")
                                        {
                                            <span class="badge bg-success">Fully Paid</span>
                                        }
                                        else if (item.Status == "Partially Paid")
                                        {
                                            <span class="badge bg-warning text-dark">Partially Paid</span>
                                        }
                                        else if (item.Status == "Unpaid")
                                        {
                                            <span class="badge bg-danger">Unpaid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Not assessed</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.StudentNumber))
                                        {
                                            <!-- Trigger Update Modal -->
                                            <button type="button"
                                                    class="btn btn-sm btn-primary"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#updatePaymentModal"
                                                    data-student-name="@item.StudentName"
                                                    data-student-number="@item.StudentNumber"
                                                    data-course-code="@item.CourseCode"
                                                    data-balance="@(item.RemainingBalance?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0.00")"
                                                    data-status="@(item.Status == "Not assessed" ? "Unpaid" : item.Status)">
                                                Update Assessment
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">Student number is required to update assessment.</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">Wala pang naaprubahang estudyanteng kailangang i-assess.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/AdminDashboard" class="btn btn-secondary">&larr; Back to Admin Dashboard</a>
    </div>

    <div class="modal fade" id="updatePaymentModal" tabindex="-1" aria-labelledby="updatePaymentModalTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="UpdatePayment">
                    <input type="hidden" name="studentNumber" id="paymentStudentNumber" />
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="updatePaymentModalTitle">Update Assessment</h5>
                            <div class="small text-muted" id="paymentStudentDetails"></div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-start">
                        <div class="mb-3">
                            <label for="paymentRemainingBalance" class="form-label">Remaining Balance (₱)</label>
                            <input type="number" min="0" step="0.01" name="newBalance" id="paymentRemainingBalance" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="paymentStatus" class="form-label">Payment Status</label>
                            <select name="newStatus" id="paymentStatus" class="form-select" required>
                                <option value="Unpaid">Unpaid</option>
                                <option value="Partially Paid">Partially Paid</option>
                                <option value="Fully Paid">Fully Paid</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-success">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const modal = document.getElementById('updatePaymentModal');
            if (!modal) return;

            modal.addEventListener('show.bs.modal', event => {
                const trigger = event.relatedTarget;
                if (!(trigger instanceof HTMLElement)) return;

                document.getElementById('paymentStudentNumber').value = trigger.dataset.studentNumber || '';
                document.getElementById('paymentStudentDetails').textContent =
                    `${trigger.dataset.studentName || ''} · ${trigger.dataset.studentNumber || ''} · ${trigger.dataset.courseCode || ''}`;
                document.getElementById('paymentRemainingBalance').value = trigger.dataset.balance || '0.00';
                document.getElementById('paymentStatus').value = trigger.dataset.status || 'Unpaid';
            });
        })();
    </script>
}