{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=SmartEnrollSystem;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Authentication": {
    "JwtBearer": {
      "Authority": "https://your-auth-server.com",
      "Audience": "your-audience",
      "RequireHttpsMetadata": true
    }
  },
  "AppSettings": {
    "Secret": "your-very-secure-secret-key",
    "TokenExpiration": "30" // Token expiration time in minutes
  }
}