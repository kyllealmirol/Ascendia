@page
@model Ascendia.Pages.Admin.AcademicRequestsModel
@{
    ViewData["Title"] = "Academic Status & Requests Module";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Academic Status & Request Logs</h2>
    <p class="text-muted">Process Drop Subject, LOA/Stop, and Transfer requests from students.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white fw-bold">Pending Student Academic Requests</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover academic-requests-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Request ID</th>
                            <th>Student ID</th>
                            <th>Student Name</th>
                            <th>Course</th>
                            <th>Request Type</th>
                            <th>Details / Reason</th>
                            <th>Date Filed</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RequestsList != null && Model.RequestsList.Any())
                        {
                            @foreach (var req in Model.RequestsList)
                            {
                                <tr>
                                    <td>@req.Id</td>
                                    <td>@req.StudentNumber</td>
                                    <td>@req.StudentName</td>
                                    <td>@req.CurrentCourse</td>
                                    <td><span class="badge academic-request-type">@req.RequestType</span></td>
                                    <td>@req.Details</td>
                                    <td>@req.DateFiledUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>
                                        <span class="badge academic-request-status @(req.Status == "Pending" ? "pending" : req.Status == "Approved" ? "approved" : "rejected")">@req.Status</span>
                                    </td>
                                    <td>
                                        @if (req.Status == "Pending")
                                        {
                                            <form method="post" asp-page-handler="Approve" asp-route-id="@req.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                            </form>
                                            <form method="post" asp-page-handler="Reject" asp-route-id="@req.Id" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">Walang kasalukuyang academic requests.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/AdminDashboard" class="btn btn-secondary">&larr; Back to Admin Dashboard</a>
    </div>
</div>