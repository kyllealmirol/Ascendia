@page
@model Ascendia.Pages.Admin.CoursesManagementModel
@{
    ViewData["Title"] = "Departments & Courses Management";
}

<div class="container mt-4">
    <h2 class="text-success fw-bold">Departments &amp; Courses Management</h2>
    <p class="text-muted">Add, edit, or remove academic courses and map them to their respective departments.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-bold">Add New Course</div>
        <div class="card-body">
            <form method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-3">
                    <label asp-for="NewCourse.CourseCode" class="form-label">Course Code</label>
                    <input asp-for="NewCourse.CourseCode" class="form-control" required placeholder="e.g. BSCS, BSCpE" />
                    <span asp-validation-for="NewCourse.CourseCode" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="NewCourse.CourseName" class="form-label">Course Name</label>
                    <input asp-for="NewCourse.CourseName" class="form-control" required placeholder="e.g. BS Computer Science" />
                    <span asp-validation-for="NewCourse.CourseName" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="NewCourse.Description" class="form-label">Course Description</label>
                    <textarea asp-for="NewCourse.Description" class="form-control" rows="3" placeholder="Enter a description of the course"></textarea>
                    <span asp-validation-for="NewCourse.Description" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-success">Add Course</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">Existing Courses List</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Course details and actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CoursesList != null && Model.CoursesList.Any())
                        {
                            @foreach (var course in Model.CoursesList)
                            {
                                <tr>
                                    <td>
                                        <form method="post" asp-page-handler="Update" asp-route-id="@course.Id" class="row g-2">
                                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                                            <div class="col-md-3">
                                                <label class="visually-hidden" asp-for="EditCourse.CourseCode">Course Code</label>
                                                <input asp-for="EditCourse.CourseCode" value="@course.CourseCode" class="form-control form-control-sm" required aria-label="Course code" />
                                                <span asp-validation-for="EditCourse.CourseCode" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="visually-hidden" asp-for="EditCourse.CourseName">Course Name</label>
                                                <input asp-for="EditCourse.CourseName" value="@course.CourseName" class="form-control form-control-sm" required aria-label="Course name" />
                                                <span asp-validation-for="EditCourse.CourseName" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-4">
                                                <label class="visually-hidden" asp-for="EditCourse.Description">Description</label>
                                                <textarea asp-for="EditCourse.Description" class="form-control form-control-sm" rows="2" aria-label="Course description">@course.Description</textarea>
                                                <span asp-validation-for="EditCourse.Description" class="text-danger"></span>
                                            </div>
                                            <div class="col-md-2 d-flex gap-1 align-items-start">
                                                <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                            </div>
                                        </form>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@course.Id" class="mt-1">
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Sigurado ka bang gusto mong tanggalin ang kursong ito?');">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td class="text-center py-4 text-muted">Walang pang nakatalang kurso.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/AdminDashboard" class="btn btn-secondary">&larr; Back to Admin Dashboard</a>
    </div>
</div>
