@page
@model Ascendia.Pages.Admin.StudentApplicationsModel
@{
    ViewData["Title"] = "Student Applications Module";
}

<div class="container mt-4">
    <h2 class="text-success fw-bold">Student Applications Management</h2>
    <p class="text-muted">Review pending student applications, verify documents, and approve or reject submissions.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm mt-4">
        <div class="card-header bg-dark text-white fw-bold">Pending Enrollment Applications</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student ID</th>
                            <th>Full Name</th>
                            <th>Course / Program</th>
                            <th>Student Type</th>
                            <th>Assigned Section</th> <!-- Idinagdag para sa Auto-Generated Section -->
                            <th>Documents</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="studentApplicationsTableBody">
                        @if (Model.StudentsList != null && Model.StudentsList.Any())
                        {
                            @foreach (var student in Model.StudentsList)
                            {
                                <tr id="student-application-row-@student.Id">
                                    <td>@(string.IsNullOrWhiteSpace(student.StudentNumber) ? "Not assigned" : student.StudentNumber)</td>
                                    <td>@(student.FullName ?? student.StudentName)</td>
                                    <td>
                                        <span class="badge bg-secondary">@(student.AcademicCourse?.CourseCode ?? student.CourseCode)</span>
                                        <div>@(student.AcademicCourse?.CourseName ?? student.Course)</div>
                                        @if (!string.IsNullOrWhiteSpace(student.AcademicCourse?.Description))
                                        {
                                            <div class="small text-muted">@student.AcademicCourse.Description</div>
                                        }
                                    </td>
                                    <td>@student.StudentType</td>
                                    <td>
                                        <!-- Nagpapakita ng seksyon kung meron na, o kaya ay N/A habang pending -->
                                        <span class="badge bg-info text-dark">@(string.IsNullOrEmpty(student.Section) ? "Pending Assignment" : student.Section)</span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(student.StudentNumber))
                                        {
                                            <span class="small text-muted">Student number is required to access documents.</span>
                                        }
                                        else
                                        {
                                            @if (!string.IsNullOrWhiteSpace(student.Form138Path))
                                            {
                                                <a asp-page-handler="Document" asp-route-studentNumber="@student.StudentNumber" asp-route-documentType="form138" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1">Form 138</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(student.PsaBirthCertificatePath))
                                            {
                                                <a asp-page-handler="Document" asp-route-studentNumber="@student.StudentNumber" asp-route-documentType="psa" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1">PSA</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(student.Form137Path))
                                            {
                                                <a asp-page-handler="Document" asp-route-studentNumber="@student.StudentNumber" asp-route-documentType="form137" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1">Form 137</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(student.GoodMoralPath))
                                            {
                                                <a asp-page-handler="Document" asp-route-studentNumber="@student.StudentNumber" asp-route-documentType="goodmoral" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1">Good Moral</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(student.TorPath))
                                            {
                                                <a asp-page-handler="Document" asp-route-studentNumber="@student.StudentNumber" asp-route-documentType="tor" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary me-1">TOR</a>
                                            }
                                            @if (string.IsNullOrWhiteSpace(student.Form138Path)
                                                && string.IsNullOrWhiteSpace(student.PsaBirthCertificatePath)
                                                && string.IsNullOrWhiteSpace(student.Form137Path)
                                                && string.IsNullOrWhiteSpace(student.GoodMoralPath)
                                                && string.IsNullOrWhiteSpace(student.TorPath))
                                            {
                                                <span class="small text-muted">Walang dokumentong na-upload.</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-warning text-dark">@student.Status</span>
                                    </td>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(student.StudentNumber))
                                        {
                                            <span class="small text-muted">Student number is required to process this application.</span>
                                        }
                                        else
                                        {
                                            <!-- Approve Form -->
                                            <form method="post" asp-page-handler="Approve" asp-route-studentNumber="@student.StudentNumber" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                            </form>

                                            <!-- Reject Trigger Button -->
                                            <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal@(student.Id)">
                                                Reject
                                            </button>

                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="student-applications-empty-row">
                                <td colspan="8" class="text-center py-4 text-muted">Walang kasalukuyang pending na aplikasyon.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.StudentsList is not null)
            {
                @foreach (var student in Model.StudentsList.Where(student => !string.IsNullOrWhiteSpace(student.StudentNumber)))
                {
                    <div class="modal fade" id="rejectModal@(student.Id)" tabindex="-1" aria-labelledby="rejectModalLabel@(student.Id)" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                            <form method="post"
                                  asp-page-handler="Reject"
                                  asp-route-id="@student.Id"
                                  data-row-id="student-application-row-@student.Id"
                                  class="modal-content reject-application-form">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="rejectModalLabel@(student.Id)">Reject Application - @(student.FullName ?? student.StudentName)</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>

                                @section Scripts {
                                    <script>
                                        document.querySelectorAll("form.reject-application-form").forEach((form) => {
                                            form.addEventListener("submit", async (event) => {
                                                event.preventDefault();

                                                const submitButton = form.querySelector('button[type="submit"]');
                                                if (submitButton) {
                                                    submitButton.disabled = true;
                                                }

                                                try {
                                                    const response = await fetch(form.action, {
                                                        method: "POST",
                                                        body: new FormData(form),
                                                        headers: { "X-Requested-With": "XMLHttpRequest" }
                                                    });
                                                    const result = await response.json();
                                                    if (!response.ok || result.success !== true || result.deleted !== true) {
                                                        throw new Error(result.message || "Hindi na-delete ang student application.");
                                                    }

                                                    const modal = form.closest(".modal");
                                                    const modalInstance = modal && bootstrap.Modal.getInstance(modal);
                                                    if (modalInstance) {
                                                        modal.addEventListener("hidden.bs.modal", () => modal.remove(), { once: true });
                                                        modalInstance.hide();
                                                    } else {
                                                        modal?.remove();
                                                    }

                                                    document.getElementById(form.dataset.rowId)?.remove();
                                                    const tableBody = document.getElementById("studentApplicationsTableBody");
                                                    if (tableBody && !tableBody.querySelector("tr[id^='student-application-row-']")) {
                                                        tableBody.innerHTML =
                                                            '<tr id="student-applications-empty-row"><td colspan="8" class="text-center py-4 text-muted">Walang kasalukuyang pending na aplikasyon.</td></tr>';
                                                    }

                                                    const alert = document.createElement("div");
                                                    alert.className = "alert alert-success alert-dismissible fade show";
                                                    alert.setAttribute("role", "alert");
                                                    alert.textContent = result.message;
                                                    const closeButton = document.createElement("button");
                                                    closeButton.type = "button";
                                                    closeButton.className = "btn-close";
                                                    closeButton.setAttribute("data-bs-dismiss", "alert");
                                                    closeButton.setAttribute("aria-label", "Close");
                                                    alert.append(closeButton);
                                                    document.querySelector(".container.mt-4")?.prepend(alert);
                                                } catch (error) {
                                                    console.error("Failed to reject student application.", error);
                                                    window.alert(error.message || "Nagkaroon ng error sa pag-delete ng application.");
                                                    if (submitButton) {
                                                        submitButton.disabled = false;
                                                    }
                                                }
                                            });
                                        });
                                    </script>
                                }
                                <div class="modal-body">
                                    <p class="mb-0">Ang pag-reject ay permanenteng magde-delete sa enrollment application at hindi na ito maibabalik. Magpatuloy?</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-danger">Confirm Reject</button>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/AdminDashboard" class="btn btn-secondary">&larr; Back to Admin Dashboard</a>
    </div>
</div>