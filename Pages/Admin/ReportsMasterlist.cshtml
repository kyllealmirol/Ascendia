@page
@model Ascendia.Pages.Admin.ReportsMasterlistModel
@{
    ViewData["Title"] = "Reports & Masterlist";
}

<div class="container mt-4">
    <h2 class="text-primary fw-bold">Reports & Masterlist</h2>
    <p class="text-muted">View submitted applications and enrolled student records using the current course details.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Report Actions & Filters Card -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white fw-bold">Report Actions & Filters</div>
        <div class="card-body">
            <form method="get" asp-page="/Admin/ReportsMasterlist">
                <div class="row align-items-end">
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="SelectedCategory" class="form-label fw-bold">Select Report Category</label>
                        <select asp-for="SelectedCategory" asp-items="Model.CourseOptions" class="form-select">
                            <option value="">All Enrolled Students</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3 mb-md-0">
                        <label asp-for="SearchTerm" class="form-label fw-bold">Search Student</label>
                        <input asp-for="SearchTerm"
                               class="form-control"
                               placeholder="Student ID / Number or name"
                               autocomplete="off" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Generate Report</button>
                    </div>
                    <div class="col-md-2 mt-2 mt-md-0">
                        <!-- Direct Print / PDF Save Button -->
                        <button type="button" class="btn btn-success w-100" onclick="window.print();">
                            🖨️ Print / Save PDF
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- System Masterlist Summary Table -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">Student Applications and Masterlist</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student ID</th>
                            <th>Full Name</th>
                            <th>Course Program</th>
                            <th>Status</th>
                            <th>Submitted Requirements</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Masterlist != null && Model.Masterlist.Any())
                        {
                            @foreach (var item in Model.Masterlist)
                            {
                                <tr>
                                    <td>@(string.IsNullOrWhiteSpace(item.StudentId) ? "Not assigned" : item.StudentId)</td>
                                    <td>@item.FullName</td>
                                    <td>
                                        <span class="badge bg-secondary">@item.CourseCode</span>
                                        @if (!string.IsNullOrWhiteSpace(item.CourseProgram)
                                            && !string.Equals(item.CourseProgram, item.CourseCode, StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="small text-muted">@item.CourseProgram</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary d-none d-print-inline">@item.Status</span>
                                        @if (!string.IsNullOrWhiteSpace(item.StudentId))
                                        {
                                            <form method="post" asp-page-handler="UpdateStatus" class="d-flex flex-wrap align-items-center gap-2 status-edit-controls">
                                                <input type="hidden" name="studentNumber" value="@item.StudentId" />
                                                <input type="hidden" name="selectedCategory" value="@Model.SelectedCategory" />
                                                <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                                                <select name="newStatus" class="form-select form-select-sm" aria-label="Status for @item.FullName" required>
                                                    <option value="Pending" selected="@(item.Status == "Pending" ? "selected" : null)">Pending</option>
                                                    <option value="Enrolled" selected="@(item.Status == "Enrolled" ? "selected" : null)">Enrolled</option>
                                                    <option value="Dropped" selected="@(item.Status == "Dropped" ? "selected" : null)">Dropped</option>
                                                    <option value="Stopped" selected="@(item.Status == "Stopped" ? "selected" : null)">Stopped</option>
                                                    <option value="LOA" selected="@(item.Status == "LOA" ? "selected" : null)">LOA</option>
                                                    <option value="Transferred" selected="@(item.Status == "Transferred" ? "selected" : null)">Transferred</option>
                                                    <option value="Rejected" selected="@(item.Status == "Rejected" ? "selected" : null)">Rejected</option>
                                                </select>
                                                <button type="submit" class="btn btn-sm btn-outline-warning">Update</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@(string.IsNullOrWhiteSpace(item.Status) ? "Unknown" : item.Status)</span>
                                            <div class="small text-muted status-edit-controls">Student Number required for updates.</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1 mb-2 submitted-requirements">
                                            @foreach (var requirement in item.Requirements)
                                            {
                                                if (requirement.IsSubmitted)
                                                {
                                                    <a class="badge badge-success bg-success requirement-submitted-badge text-decoration-none"
                                                       asp-page-handler="RequirementDocument"
                                                       asp-route-studentId="@item.DatabaseId"
                                                       asp-route-requirementKey="@requirement.Key"
                                                       target="_blank"
                                                       rel="noopener">
                                                        @requirement.Label
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button type="button"
                                                            class="badge badge-danger bg-danger requirement-missing-badge border-0 requirement-upload-trigger"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#requirementUploadModal"
                                                            data-requirement-key="@requirement.Key"
                                                            data-requirement-label="@requirement.Label"
                                                            data-student-id="@item.DatabaseId"
                                                            data-student-name="@item.FullName">
                                                        @requirement.Label
                                                    </button>
                                                }
                                            }
                                        </div>
                                        @if (item.RequirementsComplete)
                                        {
                                            <span class="badge bg-success requirement-complete-badge requirements-overall-status">Requirements Complete</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger requirement-pending-badge requirements-overall-status">Pending Requirements</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Walang nakitang rekord.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <style>
                .submitted-requirements .requirement-submitted-badge,
                .requirements-overall-status.requirement-complete-badge {
                    background-color: #198754 !important;
                    color: #fff !important;
                }

                .submitted-requirements .requirement-missing-badge,
                .requirements-overall-status.requirement-pending-badge {
                    background-color: #dc3545 !important;
                    color: #fff !important;
                }

                .submitted-requirements .requirement-submitted-badge:hover,
                .submitted-requirements .requirement-submitted-badge:focus {
                    background-color: #157347 !important;
                    color: #fff !important;
                }

                .submitted-requirements .requirement-missing-badge:hover,
                .submitted-requirements .requirement-missing-badge:focus {
                    background-color: #bb2d3b !important;
                    color: #fff !important;
                }

                @@media print {
                    .status-edit-controls {
                        display: none !important;
                    }
                    .requirement-upload-trigger {
                        cursor: default;
                    }
                    .requirements-overall-status {
                        display: inline-block;
                    }
                }
            </style>
        </div>
    </div>

    <div class="modal fade" id="requirementUploadModal" tabindex="-1" aria-labelledby="requirementUploadModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" asp-page-handler="UploadRequirement" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title" id="requirementUploadModalLabel">Upload Requirement</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">
                            Uploading <strong id="selectedRequirementLabel"></strong> for
                            <strong id="selectedRequirementStudent"></strong>.
                        </p>
                        <input type="hidden" name="studentId" id="requirementsStudentId" />
                        <input type="hidden" name="requirementKey" id="requirementsKey" />
                        <input type="hidden" name="selectedCategory" value="@Model.SelectedCategory" />
                        <input type="hidden" name="searchTerm" value="@Model.SearchTerm" />
                        <label for="requirementFile" class="form-label">Requirement file</label>
                        <input type="file" class="form-control" id="requirementFile" name="requirementFile" required />
                        <div class="form-text">PDF o image file, hanggang 10 MB. Para sa 2x2 picture, image file lamang.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Upload Requirement</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/AdminDashboard" class="btn btn-secondary">&larr; Back to Admin Dashboard</a>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".requirement-upload-trigger").forEach((button) => {
            button.addEventListener("click", () => {
                document.getElementById("requirementsStudentId").value = button.dataset.studentId;
                document.getElementById("requirementsKey").value = button.dataset.requirementKey;
                document.getElementById("selectedRequirementLabel").textContent = button.dataset.requirementLabel;
                document.getElementById("selectedRequirementStudent").textContent = button.dataset.studentName;

                const fileInput = document.getElementById("requirementFile");
                fileInput.value = "";
                fileInput.accept = button.dataset.requirementKey === "picture"
                    ? ".png,.jpg,.jpeg,.gif,.webp,.bmp"
                    : ".pdf,.png,.jpg,.jpeg,.gif,.webp,.bmp";
            });
        });
    </script>
}